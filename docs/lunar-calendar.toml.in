[library]
version = "@version@"
browse_url = "https://github.com/yetist/lunar-calendar"
repository_url = "https://github.com/yetist/lunar-calendar.git"
website_url = "https://lunar-calendar.zhcn.cc"
docs_url = "https://lunar-calendar.zhcn.cc"
authors = "yetist <yetist@gmail.com>"
license = "LGPL-2.1-only"
description = "The Chinese Lunar Calendar Library"
dependencies = ["GObject-2.0", "GLib-2.0"]
devhelp = true
search_index = true

[dependencies."Gtk-3.0"]
  name = "Gtk"
  description = "The base type system library"
  docs_url = "https://docs.gtk.org/gtk3/"

[theme]
name = "basic"
show_index_summary = true
show_class_hierarchy = true

[source-location]
base_url = "https://github.com/yetist/lunar-calendar/blob/master/"

[extra]
urlmap_file = "urlmap.js"

[check]
ignore_deprecated = true
